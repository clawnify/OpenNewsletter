{
  "$schema": "https://app.clawnify.com/schema/v1/clawnify.json",
  "name": "Open Newsletter",
  "icon": "icon.svg",
  "description": "Generation-first newsletter studio. Draft issues with AI, design them with live DESIGN.md tokens, and send to a subscriber list you own. An open-source alternative to Mailchimp, beehiiv, Substack, and ConvertKit.",
  "template": {
    "displayName": "Newsletter",
    "category": "Marketing"
  },
  "app": {
    "framework": "react+hono",
    "database": true,
    "storage": true,
    "credentials": ["resend"],
    "api": {
      "public_routes": [
        "/api/subscribe",
        "/api/confirm",
        "/api/unsubscribe",
        "/widget.js",
        "/api/jobs/send-mail"
      ]
    }
  },
  "env": {
    "oneOf": [["OPENROUTER_API_KEY"]],
    "optional": ["RESEND_API_KEY", "NEWSLETTER_MODEL"]
  }
}
